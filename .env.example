# Vercel (web) and Render (worker) both need DATABASE_URL, pointed at the
# same Render Postgres instance — Vercel uses the External Database URL,
# the worker on Render uses the Internal Database URL. Both need
# connection_limit=2&pool_timeout=30 appended — without it, Prisma's default
# per-client pool size causes Render's free Postgres to drop connections
# under load (confirmed during this migration's test-suite validation).
DATABASE_URL="postgresql://user:password@host:5432/promptproof?sslmode=require&connection_limit=2&pool_timeout=30"

# Worker only (lib/claude.ts) — NVIDIA's hosted LLM API.
NVIDIA_API_KEY=""

# Worker only (worker/index.ts), optional.
SENTRY_DSN=

# Render injects PORT and RENDER_EXTERNAL_URL automatically on its Web
# Services — no need to set these manually except for local testing of
# worker/artifacts-server.ts.
